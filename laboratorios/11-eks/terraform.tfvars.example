# Copie para terraform.tfvars, ignorado no Git, e substitua TODOS os placeholders.
region              = "us-east-1"
cluster_name        = "curso-eks"
kubernetes_version  = "1.35"
availability_zones  = ["us-east-1a", "us-east-1b", "us-east-1c"]
admin_principal_arn = "arn:aws:iam::111122223333:role/SUA_ROLE_ADMINISTRATIVA"
admin_public_cidr   = "203.0.113.10/32"
instance_type       = "t4g.medium"
addon_versions = {
  vpc-cni                = "CONSULTE_A_API"
  coredns                = "CONSULTE_A_API"
  kube-proxy             = "CONSULTE_A_API"
  eks-pod-identity-agent  = "CONSULTE_A_API"
  aws-ebs-csi-driver     = "CONSULTE_A_API"
}
