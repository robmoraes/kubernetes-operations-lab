{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyTaggedLabVolumes",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:REGIAO:CONTA:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Curso": "kubernetes",
          "aws:RequestTag/ebs.csi.aws.com/cluster": "true"
        }
      }
    },
    {
      "Sid": "TagOnlyDuringLabVolumeCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:REGIAO:CONTA:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateVolume",
          "aws:RequestTag/Curso": "kubernetes",
          "aws:RequestTag/ebs.csi.aws.com/cluster": "true"
        }
      }
    },
    {
      "Sid": "OperateOnlyExistingTaggedLabVolumes",
      "Effect": "Allow",
      "Action": ["ec2:AttachVolume", "ec2:DetachVolume", "ec2:ModifyVolume", "ec2:DeleteVolume"],
      "Resource": "arn:aws:ec2:REGIAO:CONTA:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Curso": "kubernetes",
          "ec2:ResourceTag/ebs.csi.aws.com/cluster": "true"
        }
      }
    },
    {
      "Sid": "AttachOnlyToLabWorkers",
      "Effect": "Allow",
      "Action": ["ec2:AttachVolume", "ec2:DetachVolume"],
      "Resource": [
        "arn:aws:ec2:REGIAO:CONTA:instance/WORKER_1_ID",
        "arn:aws:ec2:REGIAO:CONTA:instance/WORKER_2_ID"
      ]
    }
  ]
}
